# Alta · variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA coloque valores reais neste arquivo nem mande chaves no chat.

# --- Modo da IA ---
# "simulado": respostas de exemplo, sem custo (padrão durante o desenvolvimento)
# "real": usa a API do Claude (exige ANTHROPIC_API_KEY com crédito)
ALTA_MODO_IA=simulado

# --- Supabase (Project Settings → API Keys) ---
# URL do projeto: botão "Connect" no topo do painel, ou Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública: "Publishable key" (sb_publishable_...) ou, na aba Legacy, "anon public"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: "Secret key" (sb_secret_...) ou, na aba Legacy, "service_role". NUNCA compartilhe.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (console.anthropic.com → API Keys) · só quando ALTA_MODO_IA=real ---
ANTHROPIC_API_KEY=

# --- Envio do código de login por e-mail (resend.com → API Keys) ---
RESEND_API_KEY=

# --- App ---
APP_URL=https://alta.growth4u.com.br
ADMIN_EMAILS=
TZ=America/Sao_Paulo

# --- Fases seguintes (deixar em branco por enquanto) ---
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# VOYAGE_API_KEY=
# TRANSCRIPTION_API_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
